@model List<RaceDay.MVC.Models.MyEnrolmentItem>
    @{ ViewData["Title"] = "My Entries"; }

    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="fw-bold mb-0">
                <i class="fas fa-ticket-alt me-2 text-primary"></i>My Entries
            </h1>
            <a asp-controller="Participant" asp-action="Events" class="btn btn-outline-primary">
                <i class="fas fa-search me-2"></i>Find More Events
            </a>
        </div>

        <!-- Status legend -->
        <div class="d-flex flex-wrap gap-2 mb-4">
            <span class="badge bg-success py-2 px-3"><i class="fas fa-check me-1"></i>Confirmed</span>
            <span class="badge bg-warning text-dark py-2 px-3"><i class="fas fa-clock me-1"></i>Waitlisted</span>
            <span class="badge bg-secondary py-2 px-3"><i class="fas fa-times me-1"></i>Cancelled</span>
        </div>

        @if (!Model.Any())
        {
            <div class="card border-0 bg-light text-center py-5">
                <i class="fas fa-ticket-alt fa-4x text-muted mb-3"></i>
                <h4 class="text-muted">No entries yet</h4>
                <p class="text-muted mb-3">Browse upcoming events and enter your first race!</p>
                <a asp-controller="Participant" asp-action="Events" class="btn rd-btn-primary">
                    <i class="fas fa-search me-2"></i>Browse Events
                </a>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var item in Model)
                {
                    <div class="col-md-6">
                        <div class="card h-100 shadow-sm
                        @(item.Status == "Confirmed" ? "border-success" :
                          item.Status == "Waitlisted" ? "border-warning" : "border-secondary")
                        border-start border-4">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-2">

                                    @if (item.Status == "Confirmed")
                                    {
                                        <span class="badge bg-success">
                                            <i class="fas fa-check-circle me-1"></i>Confirmed
                                        </span>
                                    }
                                    else if (item.Status == "Waitlisted")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            <i class="fas fa-clock me-1"></i>Waitlisted
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            <i class="fas fa-times-circle me-1"></i>Cancelled
                                        </span>
                                    }

                                    @if (item.Event?.Sport == "Cycling")
                                    {
                                        <span class="badge bg-success">Cycling</span>
                                    }
                                    else if (item.Event?.Sport == "Walking")
                                    {
                                        <span class="badge bg-warning text-dark">Walking</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary">@item.Event?.Sport</span>
                                    }

                                </div>

                                <h5 class="fw-bold mb-1">@item.Event?.Name</h5>
                                <p class="text-muted small mb-1">
                                    <i class="fas fa-calendar me-1"></i>@item.Event?.EventDate &nbsp;
                                    <i class="fas fa-map-marker-alt ms-2 me-1"></i>@item.Event?.Location
                                </p>
                                <p class="text-muted small mb-3">
                                    <i class="fas fa-tag me-1"></i>@item.Event?.Category
                                </p>

                                @if (item.Result != null)
                                {
                                    <div class="alert alert-success py-2 mb-3">
                                        <div class="fw-bold mb-1">
                                            <i class="fas fa-trophy me-2"></i>Race Result
                                        </div>
                                        <div class="d-flex gap-4">
                                            <div>
                                                <div class="small text-muted">Finish Time</div>
                                                <strong class="text-success">@item.Result.FinishTime</strong>
                                            </div>
                                            @if (item.Result.Position.HasValue)
                                            {
                                                <div>
                                                    <div class="small text-muted">Position</div>
                                                    <strong class="text-success">#@item.Result.Position</strong>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }

                                <div class="d-flex justify-content-between align-items-center">
                                    <small class="text-muted">
                                        Entered @item.EnrolledAt
                                    </small>
                                    @if (item.Status == "Confirmed")
                                    {
                                        <form asp-controller="Participant" asp-action="CancelEnrolment"
                                              asp-route-id="@item.EnrolmentId" method="post"
                                              onsubmit="return confirm('Cancel your entry for this event?')">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="fas fa-times me-1"></i>Cancel Entry
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

@* My Entries - colour coded by status *@
