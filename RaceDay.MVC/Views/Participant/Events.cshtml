@model List<RaceDay.MVC.Models.EventListItem>
@{ ViewData["Title"] = "Browse Events"; }

<div class="container py-4">
    <h1 class="fw-bold mb-4">
        <i class="fas fa-calendar-alt me-2 text-primary"></i>Upcoming Events
    </h1>

    <!-- Filter bar -->
    <form asp-action="Events" method="get" class="row g-2 mb-4">
        <div class="col-sm-5 col-md-4">
            <input type="text" name="search" value="@ViewBag.Search"
                   class="form-control" placeholder="Search by name or location..." />
        </div>
        <div class="col-sm-4 col-md-3">
            <select name="sport" class="form-select">
                <option value="">All Sports</option>
                @foreach (var sport in new[] { "Running", "Cycling", "Walking" })
                {
                    <option value="@sport" selected="@(ViewBag.Sport == sport)">@sport</option>
                }
            </select>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-outline-primary">
                <i class="fas fa-filter me-1"></i>Filter
            </button>
            @if (ViewBag.Sport != null || ViewBag.Search != null)
            {
                <a asp-action="Events" class="btn btn-outline-secondary ms-1">
                    <i class="fas fa-times me-1"></i>Clear
                </a>
            }
        </div>
    </form>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center py-5">
            <i class="fas fa-search fa-3x mb-3 d-block text-muted"></i>
            <h5>No events found</h5>
            <p class="text-muted mb-0">Try adjusting your filters or check back later.</p>
        </div>
    }
    else
    {
        <p class="text-muted mb-3">
            Showing <strong>@Model.Count</strong> event@(Model.Count != 1 ? "s" : "")
        </p>

        <div class="row g-4">
            @foreach (var ev in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card rd-event-card h-100">
                        @if (!string.IsNullOrEmpty(ev.BannerImageUrl))
                        {
                            <img src="@ev.BannerImageUrl" class="card-img-top rd-event-img"
                                 alt="@ev.Name banner" />
                        }
                        else
                        {
                            <div class="rd-event-img-placeholder">
                                @{
                                    var iconCls = ev.Category?.Sport switch
                                    {
                                        "Cycling" => "fa-biking text-success",
                                        "Walking" => "fa-walking text-warning",
                                        _ => "fa-running text-primary"
                                    };
                                }
                                <i class="fas @iconCls fa-3x"></i>
                            </div>
                        }
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="badge @(ev.Category?.Sport == "Cycling" ? "bg-success" : ev.Category?.Sport == "Walking" ? "bg-warning text-dark" : "bg-primary")">
                                    @ev.Category?.Sport
                                </span>
                                @if (ev.EntryFee == 0)
                                {
                                    <span class="badge bg-success">FREE</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">R@ev.EntryFee.ToString("F0")</span>
                                }
                            </div>
                            <h5 class="card-title fw-bold">@ev.Name</h5>
                            <p class="text-muted small mb-1">
                                <i class="fas fa-calendar me-1"></i>@ev.EventDate &nbsp;
                                <i class="fas fa-clock ms-2 me-1"></i>@ev.StartTime
                            </p>
                            <p class="text-muted small mb-3">
                                <i class="fas fa-map-marker-alt me-1"></i>@ev.Location
                            </p>
                            @if (!string.IsNullOrEmpty(ev.Description))
                            {
                                <p class="text-muted small mb-3">
                                    @(ev.Description.Length > 80 ? ev.Description[..80] + "…" : ev.Description)
                                </p>
                            }
                            <div class="mt-auto">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <small class="text-muted">
                                        <i class="fas fa-users me-1"></i>
                                        @ev.EnrolmentCount/@ev.MaxParticipants spots
                                    </small>
                                    @if (ev.EnrolmentCount >= ev.MaxParticipants)
                                    {
                                        <span class="badge bg-warning text-dark">Waitlist</span>
                                    }
                                </div>
                                <a asp-controller="Participant" asp-action="EventDetails"
                                   asp-route-id="@ev.EventId"
                                   class="btn rd-btn-primary w-100">
                                    View &amp; Enter
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
