@model RaceDay.MVC.Models.RegisterViewModel
@{ ViewData["Title"] = "Create Account"; }

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <h2 class="fw-bold mb-1 text-center">Join RaceDay</h2>
                    <p class="text-muted text-center mb-4">Create your free account</p>

                    <form asp-action="Register" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                        <!-- Role selector -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">I am a...</label>
                            <div class="d-flex gap-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="Role"
                                           id="roleParticipant" value="Participant"
                                           @(Model.Role == "Participant" ? "checked" : "") />
                                    <label class="form-check-label" for="roleParticipant">
                                        <i class="fas fa-running text-primary me-1"></i>Participant
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="Role"
                                           id="roleOrganiser" value="Organiser"
                                           @(Model.Role == "Organiser" ? "checked" : "") />
                                    <label class="form-check-label" for="roleOrganiser">
                                        <i class="fas fa-clipboard-list text-warning me-1"></i>Event Organiser
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label fw-semibold"></label>
                            <input asp-for="FullName" class="form-control" placeholder="Your full name" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-semibold"></label>
                            <input asp-for="Email" class="form-control" placeholder="your@email.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Password" class="form-label fw-semibold"></label>
                            <input asp-for="Password" class="form-control" placeholder="Min. 6 characters" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
                            <input asp-for="ConfirmPassword" class="form-control" placeholder="Repeat your password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <!-- Organiser-specific fields -->
                        <div id="organiserFields" style="display:none;">
                            <hr /><h6 class="text-warning fw-bold mb-3">Organisation Details</h6>
                            <div class="mb-3">
                                <label asp-for="Organisation" class="form-label fw-semibold">
                                    Organisation Name <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Organisation" class="form-control"
                                       placeholder="Your club or company name" />
                                <span asp-validation-for="Organisation" class="text-danger small"></span>
                            </div>
                            <div class="mb-3">
                                <label asp-for="ContactPhone" class="form-label fw-semibold"></label>
                                <input asp-for="ContactPhone" class="form-control" placeholder="+27 11 000 0000" />
                            </div>
                        </div>

                        <!-- Participant-specific fields -->
                        <div id="participantFields">
                            <hr /><h6 class="text-primary fw-bold mb-3">Personal Details (optional)</h6>
                            <div class="row g-3 mb-3">
                                <div class="col-sm-6">
                                    <label asp-for="DateOfBirth" class="form-label fw-semibold"></label>
                                    <input asp-for="DateOfBirth" type="date" class="form-control" />
                                </div>
                                <div class="col-sm-6">
                                    <label asp-for="Gender" class="form-label fw-semibold"></label>
                                    <select asp-for="Gender" class="form-select">
                                        <option value="">— Select —</option>
                                        <option>Male</option>
                                        <option>Female</option>
                                        <option>Other</option>
                                    </select>
                                </div>
                            </div>
                            <div class="mb-4">
                                <label asp-for="EmergencyContact" class="form-label fw-semibold"></label>
                                <input asp-for="EmergencyContact" class="form-control"
                                       placeholder="Name + phone number" />
                            </div>
                        </div>

                        <button type="submit" class="btn rd-btn-primary w-100 py-2 fw-semibold">
                            <i class="fas fa-user-plus me-2"></i>Create Account
                        </button>
                    </form>

                    <hr class="my-4" />
                    <p class="text-center text-muted small mb-0">
                        Already have an account?
                        <a asp-action="Login" class="fw-semibold">Log in here</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function toggleRoleFields() {
            const isOrganiser = document.querySelector('#roleOrganiser').checked;
            document.getElementById('organiserFields').style.display = isOrganiser ? 'block' : 'none';
            document.getElementById('participantFields').style.display = isOrganiser ? 'none' : 'block';
        }
        document.querySelectorAll('input[name="Role"]').forEach(r =>
            r.addEventListener('change', toggleRoleFields));
        toggleRoleFields(); // init on page load
    </script>
}

@* Register view - supports Organiser and Participant roles *@
