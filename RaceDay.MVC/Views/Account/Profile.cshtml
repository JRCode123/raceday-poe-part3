@model RaceDay.MVC.Models.ProfileViewModel
@{ ViewData["Title"] = "My Profile"; }

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">

            <!-- Header -->
            <div class="d-flex align-items-center mb-4">
                @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
                {
                    <img src="@Model.ProfilePictureUrl" alt="Profile picture"
                         class="rounded-circle me-3" width="72" height="72"
                         style="object-fit:cover;border:3px solid var(--rd-primary);" />
                }
                else
                {
                    <div class="rd-avatar-placeholder me-3">
                        <i class="fas fa-user fa-2x"></i>
                    </div>
                }
                <div>
                    <h2 class="fw-bold mb-0">@Model.FullName</h2>
                    <span class="badge @(Model.Role == "Organiser" ? "bg-warning text-dark" : "bg-info text-dark")">
                        @Model.Role
                    </span>
                    <span class="text-muted small ms-2">@Model.Email</span>
                </div>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-4">
                        <i class="fas fa-edit me-2 text-primary"></i>Edit Profile
                    </h5>

                    <form asp-action="Profile" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label fw-semibold"></label>
                            <input asp-for="FullName" class="form-control" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Email</label>
                            <input value="@Model.Email" class="form-control" disabled />
                            <div class="form-text">Email cannot be changed.</div>
                        </div>

                        @if (Model.Role == "Organiser")
                        {
                            <hr class="my-3" />
                            <h6 class="text-warning fw-bold mb-3">Organisation Details</h6>
                            <div class="mb-3">
                                <label asp-for="Organisation" class="form-label fw-semibold"></label>
                                <input asp-for="Organisation" class="form-control" />
                            </div>
                            <div class="mb-3">
                                <label asp-for="ContactPhone" class="form-label fw-semibold"></label>
                                <input asp-for="ContactPhone" class="form-control" placeholder="+27 ..." />
                            </div>
                        }
                        else
                        {
                            <hr class="my-3" />
                            <h6 class="text-primary fw-bold mb-3">Personal Details</h6>
                            <div class="row g-3 mb-3">
                                <div class="col-sm-6">
                                    <label asp-for="DateOfBirth" class="form-label fw-semibold"></label>
                                    <input asp-for="DateOfBirth" type="date" class="form-control" />
                                </div>
                                <div class="col-sm-6">
                                    <label asp-for="Gender" class="form-label fw-semibold"></label>
                                    <select asp-for="Gender" class="form-select">
                                        <option value="">— Select —</option>
                                        <option>Male</option>
                                        <option>Female</option>
                                        <option>Other</option>
                                    </select>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label asp-for="EmergencyContact" class="form-label fw-semibold"></label>
                                <input asp-for="EmergencyContact" class="form-control"
                                       placeholder="Name + phone number" />
                            </div>
                            <hr class="my-3" />
                            <h6 class="text-primary fw-bold mb-3">Profile Picture</h6>
                            <div class="mb-3">
                                <label asp-for="ProfilePicture" class="form-label fw-semibold"></label>
                                <input asp-for="ProfilePicture" type="file"
                                       class="form-control" accept="image/*" />
                                <div class="form-text">JPG or PNG, max 5 MB.</div>
                            </div>
                        }

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn rd-btn-primary px-4">
                                <i class="fas fa-save me-2"></i>Save Changes
                            </button>
                            @if (Model.Role == "Organiser")
                            {
                                <a asp-controller="Organiser" asp-action="Dashboard"
                                   class="btn btn-outline-secondary">Cancel</a>
                            }
                            else
                            {
                                <a asp-controller="Participant" asp-action="Events"
                                   class="btn btn-outline-secondary">Cancel</a>
                            }
                        </div>
                    </form>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.CreatedAt))
            {
                <p class="text-muted text-center small mt-3">
                    <i class="fas fa-calendar-plus me-1"></i>
                    Member since @DateTime.Parse(Model.CreatedAt).ToString("MMMM yyyy")
                </p>
            }
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
