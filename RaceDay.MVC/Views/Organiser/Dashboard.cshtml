@model RaceDay.MVC.Models.OrganiserDashboardViewModel
@{ ViewData["Title"] = "Organiser Dashboard"; }

<div class="container py-4">

    <!-- Welcome banner -->
    <div class="rd-page-header mb-4">
        <h1 class="fw-bold text-white mb-1">
            <i class="fas fa-tachometer-alt me-2"></i>Dashboard
        </h1>
        <p class="text-white-50 mb-0">Welcome back, <strong>@Model.OrgName</strong></p>
    </div>

    <!-- Stat cards -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="card rd-stat-card border-0 h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rd-stat-icon bg-primary bg-opacity-10 text-primary">
                        <i class="fas fa-calendar-check fa-lg"></i>
                    </div>
                    <div>
                        <div class="display-6 fw-bold lh-1">@Model.TotalEvents</div>
                        <div class="text-muted small">Total Events</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card rd-stat-card border-0 h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rd-stat-icon bg-success bg-opacity-10 text-success">
                        <i class="fas fa-users fa-lg"></i>
                    </div>
                    <div>
                        <div class="display-6 fw-bold lh-1">@Model.TotalEnrolments</div>
                        <div class="text-muted small">Total Enrolments</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card rd-stat-card border-0 h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rd-stat-icon bg-warning bg-opacity-10 text-warning">
                        <i class="fas fa-clock fa-lg"></i>
                    </div>
                    <div>
                        <div class="display-6 fw-bold lh-1">@Model.UpcomingEvents.Count</div>
                        <div class="text-muted small">Upcoming Events</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card rd-stat-card border-0 h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rd-stat-icon bg-info bg-opacity-10 text-info">
                        <i class="fas fa-chart-line fa-lg"></i>
                    </div>
                    <div>
                        <div class="display-6 fw-bold lh-1">
                            @(Model.TotalEvents > 0
                                ? (Model.TotalEnrolments / Model.TotalEvents)
                                : 0)
                        </div>
                        <div class="text-muted small">Avg. per Event</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick actions -->
    <div class="d-flex gap-2 flex-wrap mb-5">
        <a asp-controller="Organiser" asp-action="CreateEvent" class="btn rd-btn-primary">
            <i class="fas fa-plus me-2"></i>Create Event
        </a>
        <a asp-controller="Organiser" asp-action="Events" class="btn btn-outline-primary">
            <i class="fas fa-list me-2"></i>All Events
        </a>
        <a asp-controller="Organiser" asp-action="Categories" class="btn btn-outline-secondary">
            <i class="fas fa-tags me-2"></i>Manage Categories
        </a>
    </div>

    <!-- Upcoming events table -->
    <h4 class="fw-bold mb-3">
        <i class="fas fa-calendar-alt me-2 text-primary"></i>Upcoming Events
    </h4>

    @if (!Model.UpcomingEvents.Any())
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle me-2"></i>
            No upcoming events yet.
            <a asp-controller="Organiser" asp-action="CreateEvent" class="alert-link">Create your first event →</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Event</th>
                        <th>Date</th>
                        <th>Location</th>
                        <th>Category</th>
                        <th>Enrolled</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ev in Model.UpcomingEvents)
                    {
                        <tr>
                            <td>
                                <strong>@ev.Name</strong>
                                @if (!ev.IsActive)
                                {
                                    <span class="badge bg-secondary ms-1">Inactive</span>
                                }
                            </td>
                            <td><i class="fas fa-calendar me-1 text-muted"></i>@ev.EventDate</td>
                            <td><i class="fas fa-map-marker-alt me-1 text-muted"></i>@ev.Location</td>
                            <td>
                                <span class="badge @(ev.Category?.Sport == "Cycling" ? "bg-success" : ev.Category?.Sport == "Walking" ? "bg-warning text-dark" : "bg-primary")">
                                    @ev.Category?.Sport
                                </span>
                                @ev.Category?.Name
                            </td>
                            <td>
                                <span class="badge bg-info text-dark">@ev.EnrolmentCount</span>
                            </td>
                            <td>
                                <a asp-controller="Organiser" asp-action="Enrolments"
                                   asp-route-id="@ev.EventId"
                                   class="btn btn-sm btn-outline-primary me-1" title="View enrolments">
                                    <i class="fas fa-users"></i>
                                </a>
                                <a asp-controller="Organiser" asp-action="Results"
                                   asp-route-id="@ev.EventId"
                                   class="btn btn-sm btn-outline-success" title="Enter results">
                                    <i class="fas fa-trophy"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
