@model RaceDay.MVC.Models.EditEventViewModel
@{ ViewData["Title"] = "Edit Event"; }

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <nav aria-label="breadcrumb" class="mb-3">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-controller="Organiser" asp-action="Events">My Events</a></li>
                    <li class="breadcrumb-item active">Edit Event</li>
                </ol>
            </nav>

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <h2 class="fw-bold mb-4">
                        <i class="fas fa-edit me-2 text-primary"></i>Edit Event
                    </h2>

                    <form asp-action="EditEvent" asp-route-id="@Model.EventId"
                          method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
                        <input type="hidden" asp-for="EventId" />

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-semibold">Event Name <span class="text-danger">*</span></label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-semibold">Description</label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-8">
                                <label asp-for="Location" class="form-label fw-semibold">Location <span class="text-danger">*</span></label>
                                <input asp-for="Location" class="form-control" />
                                <span asp-validation-for="Location" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="CategoryID" class="form-label fw-semibold">Category <span class="text-danger">*</span></label>
                                <select asp-for="CategoryID" class="form-select">
                                    <option value="">— Select —</option>
                                    @foreach (var cat in Model.AvailableCategories)
                                    {
                                        <option value="@cat.CategoryID"
                                                selected="@(cat.CategoryID == Model.CategoryID)">
                                            @cat.Name (@cat.Sport)
                                        </option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Route" class="form-label fw-semibold">Route Description</label>
                            <input asp-for="Route" class="form-control" />
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-sm-6">
                                <label asp-for="EventDate" class="form-label fw-semibold">Event Date <span class="text-danger">*</span></label>
                                <input asp-for="EventDate" type="date" class="form-control" />
                            </div>
                            <div class="col-sm-6">
                                <label asp-for="StartTime" class="form-label fw-semibold">Start Time <span class="text-danger">*</span></label>
                                <input asp-for="StartTime" type="time" class="form-control" />
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-sm-6">
                                <label asp-for="MaxParticipants" class="form-label fw-semibold">Max Participants</label>
                                <input asp-for="MaxParticipants" type="number" min="1" class="form-control" />
                            </div>
                            <div class="col-sm-6">
                                <label asp-for="EntryFee" class="form-label fw-semibold">Entry Fee (R)</label>
                                <div class="input-group">
                                    <span class="input-group-text">R</span>
                                    <input asp-for="EntryFee" type="number" step="0.01" min="0" class="form-control" />
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <div class="form-check form-switch">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" />
                                <label asp-for="IsActive" class="form-check-label fw-semibold">
                                    Event is Active (visible to participants)
                                </label>
                            </div>
                        </div>

                        <!-- Banner image (Azure Blob) -->
                        <div class="mb-4 p-3 border rounded bg-light">
                            <label class="form-label fw-semibold">
                                <i class="fas fa-image me-2 text-primary"></i>Event Banner Image
                            </label>
                            @if (!string.IsNullOrEmpty(Model.ExistingBannerUrl))
                            {
                                <div class="mb-2">
                                    <img src="@Model.ExistingBannerUrl" alt="Current banner"
                                         style="max-height:120px;border-radius:6px;" />
                                    <div class="form-text">Current banner image.</div>
                                </div>
                            }
                            <input asp-for="BannerImage" type="file" class="form-control"
                                   accept="image/jpeg,image/png,image/webp" />
                            <div class="form-text">
                                Upload a new image to replace the existing one (stored via API → Azure Blob).
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn rd-btn-primary px-4">
                                <i class="fas fa-save me-2"></i>Save Changes
                            </button>
                            <a asp-controller="Organiser" asp-action="Events"
                               class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
