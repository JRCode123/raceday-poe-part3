@model List<RaceDay.MVC.Models.EventListItem>
@{ ViewData["Title"] = "Welcome to RaceDay"; }

<!-- HERO BANNER -->
<section class="rd-hero">
    <div class="container text-center py-5">
        <h1 class="display-3 fw-bold text-white mb-3">
            <i class="fas fa-running me-3"></i>RaceDay
        </h1>
        <p class="lead text-white-50 mb-4">
            South Africa's road running, walking &amp; cycling events platform.
            Browse upcoming races, enter online, and track your results.
        </p>
        <a asp-controller="Participant" asp-action="Events" class="btn btn-lg rd-btn-primary me-3">
            <i class="fas fa-search me-2"></i>Browse Events
        </a>
        @if (Context.Session.GetString("UserId") == null)
        {
            <a asp-controller="Account" asp-action="Register" class="btn btn-lg btn-outline-light">
                <i class="fas fa-user-plus me-2"></i>Join Free
            </a>
        }
    </div>
</section>

<!-- SPORT TYPE QUICK FILTERS -->
<section class="bg-light py-5">
    <div class="container">
        <h2 class="text-center fw-bold mb-4">What are you training for?</h2>
        <div class="row g-4 justify-content-center">
            <div class="col-sm-4 col-md-3">
                <a asp-controller="Participant" asp-action="Events" asp-route-sport="Running"
                   class="text-decoration-none">
                    <div class="card rd-sport-card text-center p-4 h-100">
                        <i class="fas fa-running fa-3x mb-3 text-primary"></i>
                        <h5 class="fw-bold mb-1">Running</h5>
                        <p class="text-muted small mb-0">5km · 10km · 21km · 42km</p>
                    </div>
                </a>
            </div>
            <div class="col-sm-4 col-md-3">
                <a asp-controller="Participant" asp-action="Events" asp-route-sport="Cycling"
                   class="text-decoration-none">
                    <div class="card rd-sport-card text-center p-4 h-100">
                        <i class="fas fa-biking fa-3x mb-3 text-success"></i>
                        <h5 class="fw-bold mb-1">Cycling</h5>
                        <p class="text-muted small mb-0">Road · MTB · Gran Fondo</p>
                    </div>
                </a>
            </div>
            <div class="col-sm-4 col-md-3">
                <a asp-controller="Participant" asp-action="Events" asp-route-sport="Walking"
                   class="text-decoration-none">
                    <div class="card rd-sport-card text-center p-4 h-100">
                        <i class="fas fa-walking fa-3x mb-3 text-warning"></i>
                        <h5 class="fw-bold mb-1">Walking</h5>
                        <p class="text-muted small mb-0">Park runs · Charity walks</p>
                    </div>
                </a>
            </div>
        </div>
    </div>
</section>

<!-- UPCOMING EVENTS PREVIEW -->
<section class="py-5">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold mb-0">
                <i class="fas fa-calendar-alt me-2 text-primary"></i>Upcoming Events
            </h2>
            <a asp-controller="Participant" asp-action="Events" class="btn btn-outline-primary">
                View All <i class="fas fa-arrow-right ms-1"></i>
            </a>
        </div>

        @if (!Model.Any())
        {
            <div class="alert alert-info text-center py-4">
                <i class="fas fa-calendar-times fa-2x mb-2 d-block"></i>
                No events scheduled yet — check back soon!
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var ev in Model.Take(6))
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card rd-event-card h-100">
                            @if (!string.IsNullOrEmpty(ev.BannerImageUrl))
                            {
                                <img src="@ev.BannerImageUrl" class="card-img-top rd-event-img" alt="@ev.Name banner" />
                            }
                            else
                            {
                                <div class="rd-event-img-placeholder">
                                    @{
                                        var iconClass = ev.Category?.Sport switch
                                        {
                                            "Cycling" => "fa-biking text-success",
                                            "Walking" => "fa-walking text-warning",
                                            _ => "fa-running text-primary"
                                        };
                                    }
                                    <i class="fas @iconClass fa-3x"></i>
                                </div>
                            }
                            <div class="card-body d-flex flex-column">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <span class="badge rd-sport-badge @(ev.Category?.Sport == "Cycling" ? "bg-success" : ev.Category?.Sport == "Walking" ? "bg-warning text-dark" : "bg-primary")">
                                        @ev.Category?.Sport
                                    </span>
                                    @if (ev.EntryFee == 0)
                                    {
                                        <span class="badge bg-success">FREE</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">R@ev.EntryFee.ToString("F0")</span>
                                    }
                                </div>
                                <h5 class="card-title fw-bold">@ev.Name</h5>
                                <p class="text-muted small mb-2">
                                    <i class="fas fa-calendar me-1"></i>@ev.EventDate &nbsp;
                                    <i class="fas fa-clock ms-2 me-1"></i>@ev.StartTime
                                </p>
                                <p class="text-muted small mb-3">
                                    <i class="fas fa-map-marker-alt me-1"></i>@ev.Location
                                </p>
                                <div class="mt-auto">
                                    <a asp-controller="Home" asp-action="EventDetails"
                                       asp-route-id="@ev.EventId"
                                       class="btn rd-btn-primary w-100">
                                        View Details
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>
