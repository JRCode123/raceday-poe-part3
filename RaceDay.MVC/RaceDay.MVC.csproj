<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RaceDay.MVC</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- HTTP client for API calls -->
    <PackageReference Include="Microsoft.AspNetCore.Session" Version="2.3.0" />
    <!-- For JSON serialization / deserialization of API responses -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- Azure Blob Storage (profile-picture upload goes through API, but we keep SDK here as reference) -->
    <PackageReference Include="Azure.Storage.Blobs" Version="12.19.1" />
  </ItemGroup>

</Project>
